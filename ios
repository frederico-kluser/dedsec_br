#!/usr/bin/env bash
# Boot iOS Simulator and run the dedsec app on it.
# Usage: ./ios [extra flutter run args]
#
# Defaults to iPhone 17 (non-Pro) — lighter on RAM than 17 Pro/Pro Max,
# which can easily push a 16 GB M1 into swap and freeze the system.
# Override with: IOS_SIM="iPhone 17 Pro" ./ios
#
# Env overrides:
#   IOS_SIM="iPhone 17"               # simulator name (must be in `xcrun simctl list devices available`)
#   SKIP_MEM_CHECK=1                  # bypass the pre-flight RAM check

set -euo pipefail

SIM_NAME="${IOS_SIM:-iPhone 17}"
ROOT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"

if ! command -v xcrun >/dev/null 2>&1; then
  echo "error: xcrun not found. Install Xcode command-line tools." >&2
  exit 1
fi

# Pre-flight: iOS 26 simulator alone uses ~4-5 GB on Apple Silicon.
# With Flutter build + Dart VM + Xcode, you need ~7-8 GB free or the
# whole Mac will freeze on swap. Refuse to launch below 6 GB.
if [[ "${SKIP_MEM_CHECK:-0}" != "1" ]] && command -v vm_stat >/dev/null 2>&1; then
  PAGE_SIZE=$(vm_stat | awk '/page size of/ {print $8}')
  FREE_PAGES=$(vm_stat | awk '/Pages free/ {gsub(/\./,"",$3); print $3}')
  SPEC_PAGES=$(vm_stat | awk '/Pages speculative/ {gsub(/\./,"",$3); print $3}')
  FREE_GB=$(( (FREE_PAGES + SPEC_PAGES) * PAGE_SIZE / 1024 / 1024 / 1024 ))

  if (( FREE_GB < 6 )); then
    echo "error: only ${FREE_GB} GB of RAM free." >&2
    echo "       iOS 26 Simulator + Flutter build needs at least 6 GB headroom on this Mac." >&2
    echo "       Close GitKraken / vitest / Chrome / other Electron apps first." >&2
    echo "       Top RAM users right now:" >&2
    ps -arcwwwxo 'pid,rss,command' | awk 'NR==1 || NR<=8 {printf "         %s\n", $0}' >&2
    echo "" >&2
    echo "       To bypass anyway: SKIP_MEM_CHECK=1 ./ios" >&2
    exit 1
  fi
  echo "==> RAM free: ${FREE_GB} GB (ok)"
fi

# Shut down any already-running simulators to free RAM before booting the new one.
echo "==> Shutting down any previously running simulators"
xcrun simctl shutdown all 2>/dev/null || true

UDID="$(xcrun simctl list devices available \
  | grep -E "^[[:space:]]+${SIM_NAME} \([A-F0-9-]+\)" \
  | head -1 \
  | grep -oE '[0-9A-F]{8}-[0-9A-F]{4}-[0-9A-F]{4}-[0-9A-F]{4}-[0-9A-F]{12}' || true)"

if [[ -z "${UDID}" ]]; then
  echo "error: no available iOS simulator named '${SIM_NAME}'." >&2
  echo "Available simulators:" >&2
  xcrun simctl list devices available | grep -E '^[[:space:]]+\S' >&2
  exit 1
fi

echo "==> Booting iOS Simulator: ${SIM_NAME} (${UDID})"
xcrun simctl boot "${UDID}" 2>/dev/null || true
open -a Simulator
xcrun simctl bootstatus "${UDID}" -b >/dev/null

echo "==> Launching app on ${SIM_NAME}"
cd "${ROOT_DIR}/app"
exec fvm flutter run \
  -d "${UDID}" \
  --dart-define=ENV=dev \
  --dart-define=API_BASE_URL=https://api.dedsec.local \
  "$@"
